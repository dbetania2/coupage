# Configuración de Django
SECRET_KEY=tu_secret_key_desarrollo_aqui
DEBUG=True
ALLOWED_HOSTS=*
# En producción (Render) se completa solo con RENDER_EXTERNAL_HOSTNAME.
# CSRF_TRUSTED_ORIGINS=https://catalog-api.onrender.com

# ==============================================================================
# SELECTOR DE BASE DE DATOS: 'local' (por defecto) o 'render'
# ==============================================================================
DB_MODE=local

# ------------------------------------------------------------------------------
# 1. Base de Datos LOCAL (Desarrollo diario)
# ------------------------------------------------------------------------------
LOCAL_DB_NAME=coupage_db
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=tu_contrasena_postgres_local
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=5432
DB_SSLMODE=disable

# ------------------------------------------------------------------------------
# 2. Base de Datos RENDER (Producción / Externa)
# ------------------------------------------------------------------------------
RENDER_DB_NAME=coupage_db
RENDER_DB_USER=postgres
RENDER_DB_PASSWORD=tu_password_de_render
RENDER_DB_HOST=tu_hostname_externo.oregon-postgres.render.com
RENDER_DB_PORT=5432
# RENDER_DATABASE_URL=postgresql://postgres:...@...oregon-postgres.render.com/coupage_db

# Gunicorn (producción / Docker)
PORT=8000
WEB_CONCURRENCY=1

# Configuración de Superusuario (para python manage.py createsuperuser --noinput)
DJANGO_SUPERUSER_USERNAME=tu_usuario_admin
DJANGO_SUPERUSER_EMAIL=admin@ejemplo.local
DJANGO_SUPERUSER_PASSWORD=tu_contrasena_superusuario
